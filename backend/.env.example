DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stockai
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
DATA_MODE=real
INSTALL_DATA_DEPS=false
DATA_REQUEST_TIMEOUT_SECONDS=25

# One personal key is enough for local development when fallback is enabled.
ZHIPU_API_KEY=
ZHIPU_ALLOW_CROSS_ROLE_KEY_FALLBACK=true
SEED_DEMO_DATA=false
DEMO_USER_EMAIL=demo@jintong.example.com
DEMO_USER_PASSWORD=Demo123456!

# Optional: use separate keys for each expert in production.
ZHIPU_API_KEY_NEWS=
ZHIPU_API_KEY_STOCK_DATA=
ZHIPU_API_KEY_MACRO=
ZHIPU_API_KEY_FINANCIAL=
ZHIPU_API_KEY_FUNDAMENTAL=
ZHIPU_API_KEY_INVESTMENT=
ZHIPU_MODEL=glm-4.7-flash
