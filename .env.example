# Docker Compose local development settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=stockai
POSTGRES_PORT=5433
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
DATA_MODE=real
# Set true only when enabling the optional AkShare data layer.
INSTALL_DATA_DEPS=false
DATA_REQUEST_TIMEOUT_SECONDS=25

# Optional. Authentication and profile features work without an LLM key.
ZHIPU_API_KEY=
ZHIPU_ALLOW_CROSS_ROLE_KEY_FALLBACK=true

# Demo content is opt-in and requires DATA_MODE=demo. Keep false for real mode.
SEED_DEMO_DATA=false
DEMO_USER_EMAIL=demo@jintong.example.com
DEMO_USER_PASSWORD=Demo123456!
